# Base URL of the content bucket synced from Feishu (see lambda/feishu-content-sync).
# Set this as an environment variable in the Amplify console. When empty, the
# site renders with the bundled fallback content only.
VITE_CONTENT_BASE_URL=

# Function URL of the admin API (Amplify Gen2 function admin-api). Enables /admin
# with Feishu SSO and the on-site apply forms. In Amplify CI this is written
# automatically from the backend output (see amplify.yml); set it manually only
# for local dev. When empty, /admin shows a not-configured notice and the forms
# fall back to mailto.
VITE_ADMIN_API_URL=
