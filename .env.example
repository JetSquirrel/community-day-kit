# 本地 CLI / ampx sandbox 使用；Amplify 控制台里配置同名环境变量（Secrets 单独配置，见 README）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# send-email HTTP API（与 2026 秋相同的发信通道）
EMAIL_LINK=
# 测试期所有外发改投到这个地址；生产分支必须为空
TEST_TO=
# 管理后台白名单（逗号分隔）
ALLOWED_EMAILS=
ALLOWED_OPEN_IDS=
# CLI 调 Bedrock 用的 AWS 凭证（profile 或 key），需开通 Claude 模型访问
AWS_PROFILE=
